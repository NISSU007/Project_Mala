<%- include('../partials/head', {css: 'customer', title: menu.Menu_Name }) %>
<body>
<div class="phone">
  <%- include('../partials/customer-header') %>

  <!-- ===== ฟอร์มเพิ่มลงตะกร้า ===== -->
  <form method="post" action="/table/<%= table.Table_ID %>/cart/add" id="itemForm">
    <input type="hidden" name="menuId" value="<%= menu.Menu_ID %>">
    <% if (editItem) { %><input type="hidden" name="detailId" value="<%= editItem.Order_Detail_ID %>"><% } %>

    <!-- ===== ชื่อเมนู + ปุ่มปิด ===== -->
    <div class="item-top">
      <h2><%= menu.Menu_Name %></h2>
      <a class="close-x" href="<%= editItem ? '/table/' + table.Table_ID + '/cart' : '/table/' + table.Table_ID + '/menu?tab=' + backTab + '&cat=' + menu.Category_ID %>" aria-label="ปิด">✕</a>
    </div>

    <!-- ===== รูปเมนู ===== -->
    <div class="item-hero">
      <% if (menu.Image_URL) { %><img src="<%= menu.Image_URL %>" alt="<%= menu.Menu_Name %>"><% } else { %><%= CATEGORY_ICON[menu.Category_Name] %><% } %>
    </div>

    <div class="item-body">
      <p class="item-desc"><%= menu.Description %> · <b><%= baht(menu.Price) %> บาท</b></p>

      <!-- ===== แจ้งเตือนข้อผิดพลาด ===== -->
      <% if (error === 'spice') { %>
        <div class="alert alert-red" role="alert">กรุณาเลือกระดับความเผ็ดก่อนเพิ่มลงตะกร้า</div>
      <% } else if (error === 'soldout' || menu.soldOut) { %>
        <div class="alert alert-red" role="alert">สินค้าหมด ไม่สามารถเลือกรายการนี้ได้</div>
      <% } %>

      <% if (menu.isSoup) { %>
        
        <!-- ===== [เพิ่มใหม่] ตัวเลือกสำหรับน้ำซุปแบบผสม 2 รสชาติ ===== -->
        <!-- เช็คจากชื่อเมนูว่ามีคำว่า "2 รสชาติ" หรือไม่ (สามารถปรับแก้คำเช็คได้ตามฐานข้อมูลของคุณ) -->
        <% if (menu.Menu_Name.includes('ต้องการผสม2น้ำ')) { %>
          <span class="field-label">เลือกประเภทน้ำซุป (เลือก 2 อย่าง) <span class="req">* จำเป็น</span></span>
          <div class="soup-mix-grid">
            <div class="mix-opt">
              <input type="checkbox" name="mixed_soups[]" value="หม่าล่าดั้งเดิม" id="soup1" class="soup-cb">
              <label for="soup1">หม่าล่าดั้งเดิม</label>
            </div>
            <div class="mix-opt">
              <input type="checkbox" name="mixed_soups[]" value="หม่าล่าต้มยำ" id="soup2" class="soup-cb">
              <label for="soup2">หม่าล่าต้มยำ</label>
            </div>
            <div class="mix-opt">
              <input type="checkbox" name="mixed_soups[]" value="กระดูกหมู" id="soup3" class="soup-cb">
              <label for="soup3">กระดูกหมู</label>
            </div>
            <div class="mix-opt">
              <input type="checkbox" name="mixed_soups[]" value="น้ำดำ" id="soup4" class="soup-cb">
              <label for="soup4">น้ำดำ</label>
            </div>
          </div>
        <% } %>
        <!-- =================================================== -->

        <!-- ===== ตัวเลือกระดับความเผ็ด (บังคับ) ===== -->
        <span class="field-label">เลือกระดับความเผ็ด <span class="req">* จำเป็น</span></span>
        <div class="spice-grid">
          <% spiceLevels.forEach(function (lv, i) { %>
            <div class="spice-opt">
              <input type="radio" name="spice" id="sp<%= i %>" value="<%= lv %>" required
                <%= editItem && editItem.Spiciness_Level === lv ? 'checked' : '' %>>
              <label for="sp<%= i %>">
                <span class="chilis"><%= i === 0 ? '🫑' : '🌶️'.repeat(i) %></span>
                <%= lv %>
              </label>
            </div>
          <% }) %>
        </div>
        <input type="hidden" name="qty" value="1">
      <% } else { %>
        <!-- ===== ตัวเลือกจำนวน ===== -->
        <span class="field-label">เลือกจำนวน</span>
        <div class="qty">
          <button type="button" onclick="changeQty(-1)" aria-label="ลดจำนวน">−</button>
          <span class="qty-num" id="qtyText"><%= editItem ? editItem.Quantity : 1 %></span>
          <button type="button" onclick="changeQty(1)" aria-label="เพิ่มจำนวน">+</button>
        </div>
        <input type="hidden" name="qty" id="qtyInput" value="<%= editItem ? editItem.Quantity : 1 %>">
      <% } %>

      <!-- ===== หมายเหตุ ===== -->
      <label class="field-label" for="note">หมายเหตุ (ถ้ามี)</label>
      <textarea class="note-input" id="note" name="note" rows="2" placeholder="เช่น ไม่ใส่ผักชี"><%= editItem ? editItem.Special_Note : '' %></textarea>
    </div>

    <!-- ===== ปุ่มเพิ่มลงตะกร้า ===== -->
    <div class="bottom-bar">
      <button class="bar-btn" type="submit" id="submitCartBtn" <%= menu.soldOut ? 'disabled' : '' %>>
        <span><%= editItem ? 'บันทึกการแก้ไข' : 'เพิ่มลงตะกร้า' %></span>
        <span><span id="priceText"><%= baht(menu.Price * (editItem ? editItem.Quantity : 1)) %></span> บาท</span>
      </button>
    </div>
  </form>
</div>

<!-- ===== สคริปต์ปรับจำนวน / ราคา และ ตรวจสอบการเลือกน้ำซุป ===== -->
<script>
  const unitPrice = <%= menu.Price %>;
  function changeQty(step) {
    const input = document.getElementById('qtyInput');
    let qty = parseInt(input.value) + step;
    if (qty < 1) qty = 1;
    if (qty > 99) qty = 99;
    input.value = qty;
    document.getElementById('qtyText').textContent = qty;
    document.getElementById('priceText').textContent = (qty * unitPrice).toLocaleString('th-TH');
  }

  // ===== [เพิ่มใหม่] สคริปต์ควบคุมการเลือกน้ำซุป 2 อย่าง =====
  document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = document.querySelectorAll('.soup-cb');
    const submitBtn = document.getElementById('submitCartBtn');

    if (checkboxes.length > 0 && submitBtn) {
      // 1. เริ่มต้น ปิดปุ่ม "เพิ่มลงตะกร้า" ไว้ก่อนจนกว่าจะเลือกครบ 2 อย่าง
      submitBtn.disabled = true;

      checkboxes.forEach(cb => {
        cb.addEventListener('change', function() {
          const checkedCount = document.querySelectorAll('.soup-cb:checked').length;

          if (checkedCount >= 2) {
            // 2. ถ้าเลือกครบ 2 อย่างแล้ว ให้ล็อคปุ่มที่ยังไม่ได้เลือกไม่ให้กดได้อีก
            checkboxes.forEach(box => {
              if (!box.checked) box.disabled = true;
            });
            // 3. ปลดล็อคให้กดปุ่ม "เพิ่มลงตะกร้า" ได้
            submitBtn.disabled = false;
          } else {
            // 4. ถ้ายังเลือกไม่ครบ 2 อย่าง (เช่น กดยกเลิกไป 1 อัน) ให้ปลดล็อคปุ่มตัวเลือกทั้งหมด
            checkboxes.forEach(box => {
              box.disabled = false;
            });
            // 5. ปิดปุ่ม "เพิ่มลงตะกร้า" กลับเหมือนเดิม
            submitBtn.disabled = true;
          }
        });
      });
    }
  });
  // ====================================================
</script>
</body>
</html>